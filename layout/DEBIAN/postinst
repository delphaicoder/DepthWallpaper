#!/bin/sh
set -e

# Rootless Sileo installs the app under /var/jb/Applications.
APP="/var/jb/Applications/DepthWallpaper.app"

if command -v uicache >/dev/null 2>&1; then
    if [ -d "$APP" ]; then
        uicache -p "$APP" >/dev/null 2>&1 || true
    else
        uicache -a >/dev/null 2>&1 || true
    fi
elif [ -x /var/jb/usr/bin/uicache ]; then
    if [ -d "$APP" ]; then
        /var/jb/usr/bin/uicache -p "$APP" >/dev/null 2>&1 || true
    else
        /var/jb/usr/bin/uicache -a >/dev/null 2>&1 || true
    fi
fi

exit 0
